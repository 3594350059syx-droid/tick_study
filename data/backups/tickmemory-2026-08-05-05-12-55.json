      "updatedAt": 1785906775203,
      "note": {
        "content": "\n #为什么要发布消息\n        self.pub = self.create_publisher(Image,'/camera/edges',10)\n #为什么这里不需要timer\n #self.timer = self.create_timer()\n\n    def image_callback(self,msg):\n    #不要覆盖msg变量\n        frame = self.bridge.imgmsg_to_cv2(msg,desired_encoding='bgr8')\n    #图片已经以ros2的格式发过来了，不需要再读取\n    #ret,frame = msg.read()\n        \n        gray = cv2.cvtColor(frame,cv2.COLOR_BGR2GRAY)\n\n        blurred = cv2.GaussianBlur(gray,(5,5),0)\n\n        canny = cv2.Canny(blurred,20,50)\n    #边缘检测是灰度单通道图，编码是mono8\n        edge_msg = self.bridge.cv2_to_imgmsg(canny,encoding='mono8')\n\n        self.pub.publish(edge_msg)\n        cv2.imshow('camera',canny)\n        cv2.waitKey(1)\n        \n\ndef main():\n    rclpy.init()\n    node = EdgeDectector()\n    rclpy.spin(node)\n    cv2.destroyAllWindows()\n    rclpy.shutdown()",
        "updatedAt": 1785906775203
      }
